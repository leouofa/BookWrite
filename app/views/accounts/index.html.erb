<div class="w-full">
  <div class="flex justify-between items-center mb-8">
    <h1 class="font-bold text-3xl">Your Accounts</h1>
    <div class="text-right">
      <% if user_signed_in? %>
        <p class="mb-2">Logged in as: <strong><%= current_user.email %></strong></p>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <% if @accounts.any? %>
      <div class="mb-4">
        <p class="text-gray-700 mb-2">Select an account to access:</p>
        <ul class="divide-y divide-gray-200">
          <% @accounts.each do |account| %>
            <li class="py-3">
              <%= link_to account.name, account_path(account), class: "text-blue-600 hover:underline font-medium text-lg" %>
              <% if current_user.owner_of?(account) %>
                <span class="ml-2 bg-blue-100 text-blue-800 text-xs font-medium py-0.5 px-2 rounded">Owner</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="text-gray-700">You don't have any accounts yet.</p>
    <% end %>
    
    <div class="mt-4">
      <%= link_to "Create New Account", new_account_path, class: "inline-block bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>
</div> 